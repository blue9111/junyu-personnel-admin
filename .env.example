# Use one Firebase / Google Cloud project for both web authentication and Firestore.
FIREBASE_PROJECT_ID=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=

# On Cloud Run, use its service account with Firestore access.
# For local development, authenticate with Google Application Default Credentials.
# Never put service account JSON or OAuth client secrets in VITE_ variables.
